{
  "name": "pomodoro-camera-web",
  "version": "1.0.0",
  "private": true,
  "description": "Focus-aware Pomodoro timer — browser-native TypeScript 7 port of the OpenCV Python app",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:embed": "vite --config apps/embed/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "build:embed-app": "tsc --noEmit && vite build --config apps/embed/vite.config.ts",
    "build:embed": "tsc --noEmit && vite build --config apps/embed/vite.embed.config.ts",
    "build:all": "npm run build && npm run build:embed-app && npm run build:embed",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "preview:embed": "vite preview --config apps/embed/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow-models/blazeface": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
